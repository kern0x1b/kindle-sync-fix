{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "deny": [
      "Bash(conan *)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f *)",
      "Bash(git commit --amend *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(meson *)",
      "Bash(nohup *)",
      "Bash(perl -0pi *)",
      "Bash(perl -i *)",
      "Bash(perl -pi *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(pkill -f *)",
      "Bash(python *)",
      "Bash(python2 *)",
      "Bash(python3 *)",
      "Bash(sed -i *)"
    ]
  },
  "autoMemoryEnabled": false
}
